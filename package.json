{
  "name": "devin-pocket",
  "version": "0.2.1",
  "description": "Mobile-first browser UI for Devin CLI over Agent Client Protocol (ACP): sessions, streaming and tools on Android/Termux, Linux and macOS.",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@12.6.0",
  "type": "module",
  "bin": {
    "devin-pocket": "bin/devin-pocket.mjs"
  },
  "files": [
    "bin",
    "dist",
    "install.sh",
    "install-termux.sh",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm:dev:server\" \"pnpm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts start --no-open --dev",
    "dev:web": "vite --config vite.config.ts",
    "dev:fake": "DEVIN_POCKET_AGENT=\"pnpm exec tsx test/fake-agent.ts\" pnpm run dev",
    "build": "pnpm run build:web && pnpm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsdown",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepack": "pnpm run build",
    "start": "node bin/devin-pocket.mjs start"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.5.0",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.8",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BOTOOM/devin-pocket.git"
  },
  "keywords": [
    "devin",
    "devin-cli",
    "devin-ai",
    "cognition",
    "acp",
    "agent-client-protocol",
    "ai-agent",
    "coding-agent",
    "ai-coding-assistant",
    "termux",
    "android",
    "mobile",
    "pwa",
    "web-ui",
    "self-hosted",
    "cli",
    "browser",
    "developer-tools"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/dompurify": "3.0.5",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "concurrently": "10.0.5",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "dompurify": "3.4.16",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "semantic-release": "25.0.9",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tsdown": "0.23.0",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "author": "Edwar Díaz (BOTOOM)",
  "homepage": "https://devin-pocket.edwardiaz.dev",
  "bugs": {
    "url": "https://github.com/BOTOOM/devin-pocket/issues"
  }
}
